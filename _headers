# Content-Security-Policy Headers for kirsman70.github.io
#
# This file configures HTTP security headers for GitHub Pages.
# GitHub Pages automatically reads _headers and applies them globally.
# Reference: https://docs.github.com/en/pages/configuring-a-custom-domain-for-your-github-pages-site

*
  Content-Security-Policy: default-src 'self'; \
    script-src 'self' 'unsafe-inline' 'unsafe-eval' \
      https://cdn.jsdelivr.net \
      https://cdn.tailwindcss.com \
      https://cdnjs.cloudflare.com \
      https://code.jquery.com; \
    style-src 'self' 'unsafe-inline' \
      https://cdn.jsdelivr.net \
      https://cdn.tailwindcss.com \
      https://fonts.googleapis.com \
      https://cdnjs.cloudflare.com; \
    font-src 'self' \
      https://fonts.gstatic.com \
      https://cdnjs.cloudflare.com \
      https://cdn.jsdelivr.net; \
    img-src 'self' data: blob: \
      https://avatars.githubusercontent.com \
      https://i.imgur.com; \
    connect-src 'self' \
      https://qalkibuywgookvicnuhv.supabase.co \
      https://candaan-api.vercel.app \
      https://tanggalmerah.upset.dev \
      https://www.google-analytics.com \
      https://api.adviceslip.com; \
    frame-src 'self' \
      https://www.youtube.com \
      https://www.youtube-nocookie.com \
      https://player.vimeo.com \
      https://docs.google.com \
      https://forms.gle; \
    object-src 'none'; \
    base-uri 'self'; \
    form-action 'self' \
      https://docs.google.com \
      https://forms.gle; \
    frame-ancestors 'none'; \
    upgrade-insecure-requests
